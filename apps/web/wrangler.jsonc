{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pickup-bball",
	"account_id": "b38725df47a7614f19cefb7a2b466711",
	"main": "@tanstack/react-start/server-entry",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"vars": {
		// Public origin of the deployed Worker. Update after the first deploy,
		// e.g. https://pickup-bball.<your-subdomain>.workers.dev or your custom domain.
		"BETTER_AUTH_URL": "https://pickup-bball.jlukens.workers.dev"
	},
	"r2_buckets": [
		{
			"binding": "PERMITS",
			// Create once per account: `pnpm exec wrangler r2 bucket create pickup-bball-permits`
			"bucket_name": "pickup-bball-permits"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pickup-bball-db",
			// Run `pnpm exec wrangler d1 create pickup-bball-db` from apps/web and paste the id here.
			"database_id": "db30eaf1-c959-41ba-87aa-f472b6628e68",
			"migrations_dir": "../../packages/db/src/migrations"
		}
	]
}
